run General-0-20260103-14:15:17-22808
attr configname General
attr datetime 20260103-14:15:17
attr datetimef 20260103-141517
attr experiment General
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network CoPerceptionNetwork
attr processid 22808
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config network CoPerceptionNetwork
config cmdenv-express-mode true
config sim-time-limit 86400s
config scheduler-class cRealTimeScheduler
config *.radioMedium.typename Ieee80211ScalarRadioMedium
config *.radioMedium.backgroundNoise.power -110dBm
config *.numHosts 6
config *.host[*].mobility.typename PythonMobility
config *.host[*].mobility.initFromDisplayString false
config *.host[*].mobility.initialX 0m
config *.host[*].mobility.initialY 0m
config *.host[*].mobility.initialZ 0m
config *.host[*].wlan[0].typename Ieee80211Interface
config *.host[*].wlan[0].radio.transmitter.power 20mW
config *.host[*].wlan[0].radio.receiver.sensitivity -85dBm
config *.host[*].numApps 1
config *.host[*].app[0].typename CoPerceptionApp
config *.host[*].app[0].localPort 5000
config *.host[*].app[0].destPort 5000
config *.manager.port 5555

